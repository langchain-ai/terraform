# Terraform state and working directories
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.backup
*.tfstate.*.backup

# Terraform variable files (keep examples, ignore actuals)
*.tfvars
*.auto.tfvars.json
!*.tfvars.example
secrets.auto.tfvars

# Terraform plan outputs
plan.out

# Local app-secret store (file backend in _common.sh) — chmod 600, never commit
infra/.secrets.env
infra/.secrets.env.*

# Helm generated values — contain real credentials
**/helm/values/langsmith-values*.yaml
!**/helm/values/langsmith-values*.yaml.example
# Local backup copies of generated values (e.g. before an experiment)
**/helm/values/langsmith-values*.yaml.*
!**/helm/values/langsmith-values*.yaml.example
**/values-overrides.yaml

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# OS artifacts
.DS_Store
