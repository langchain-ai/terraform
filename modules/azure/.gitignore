# Terraform state and working directories
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.backup
*.tfstate.*.backup

# Terraform variable files (keep examples, ignore actuals)
*.tfvars
*.auto.tfvars.json
!*.tfvars.example
secrets.auto.tfvars

# Terraform plan outputs
*.json
plan.out

# Local secret files generated before Key Vault exists
infra/.pg_password
infra/.api_key_salt
infra/.jwt_secret
infra/.deployments_key
infra/.agent_builder_key
infra/.insights_key
infra/.polly_key

# Helm values that make init-values writes, and your langsmith-values-local.yaml.
# They name this install's hosts and resources. A 0.17 values-overrides.yaml can
# hold plaintext secrets.
**/helm/values/langsmith-values*.yaml
!**/helm/values/langsmith-values*.yaml.example
**/helm/values/langsmith-sandbox-values*.yaml
**/values-overrides.yaml

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# OS artifacts
.DS_Store
