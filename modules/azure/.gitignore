# Terraform state and working directories
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.backup
*.tfstate.*.backup

# Terraform variable files (keep examples, ignore actuals)
*.tfvars
*.auto.tfvars.json
!*.tfvars.example
secrets.auto.tfvars

# Terraform plan outputs
*.json
plan.out

# Local secret files generated before Key Vault exists
infra/.api_key_salt
infra/.jwt_secret
infra/.deployments_key
infra/.agent_builder_key
infra/.insights_key
infra/.polly_key

# Live Helm values — generated by init-values.sh or copied from overlays/.
# May contain real credentials. Tracked sources are helm/values/values.yaml and
# everything under helm/values/overlays/, which this must not match.
/helm/values/*.yaml
!/helm/values/values.yaml

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# OS artifacts
.DS_Store
