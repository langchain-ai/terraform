# =============================================================================
# LangSmith on Azure — Production Profile
# =============================================================================
# Opinionated defaults for production deployments.
# External Postgres + Redis + Blob, in-cluster ClickHouse (or use LangChain
# Managed ClickHouse for full production — see terraform.tfvars.example).
#
# Copy to terraform.tfvars and fill in your values:
#
#   cp terraform.tfvars.production terraform.tfvars
#
# For the full annotated reference with every option explained, see:
#   terraform.tfvars.example
# =============================================================================

#------------------------------------------------------------------------------
# REQUIRED — Change these
#------------------------------------------------------------------------------
subscription_id = "your-azure-subscription-id"   # az account show --query id -o tsv

#------------------------------------------------------------------------------
# Naming
#------------------------------------------------------------------------------
name_prefix = "prod"
location    = "eastus"   # pick the region closest to your users

# Give the globally-unique names (Postgres, Redis, Storage, Key Vault) a
# per-subscription hash so they cannot collide with another LangSmith deployment.
# On an EXISTING deployment leave this false — flipping it renames every resource,
# which Terraform executes as destroy-and-recreate.
unique_resource_names = true

#------------------------------------------------------------------------------
# Sources
#------------------------------------------------------------------------------
postgres_source   = "external"     # Azure DB for PostgreSQL Flexible Server
redis_source      = "external"     # Azure Managed Redis
clickhouse_source = "in-cluster"

# Switch ClickHouse to "external" for a real production deployment. In-cluster
# puts the trace and run store on a zonal Azure managed disk, which pins the pod
# to one zone for the life of the volume. External points the chart at LangChain
# Managed ClickHouse, Altinity, or any ClickHouse you run:
#
#   clickhouse_source = "external"
#
# `make init-values` then prompts for host, HTTP port, native port, user,
# password, database, and TLS, and creates the langsmith-clickhouse secret.
# `make deploy` refuses to run if any of the seven keys is missing. None of it
# is stored in tfvars or Terraform state.

#------------------------------------------------------------------------------
# PostgreSQL — production grade, deletion protection on
#------------------------------------------------------------------------------
postgres_admin_username      = "langsmith"
postgres_database_name       = "langsmith"

#------------------------------------------------------------------------------
# Redis (Azure Managed Redis / AMR)
#------------------------------------------------------------------------------
# Azure Managed Redis. B3 = 3 GB; increase (Balanced_B5/B10/...) for high write load.
amr_sku                 = "Balanced_B3"
redis_high_availability = true   # required for the AMR SLA; unsupported on Balanced_B0

#------------------------------------------------------------------------------
# AKS — Standard_D8s_v3 (8 vCPU, 32 GiB), 3 nodes minimum
#------------------------------------------------------------------------------
# 3× Standard_D8s_v3 = 18,870m allocatable vCPU.
# Pass 2–5 (all features) requires ~17.9 vCPU — fits at 95% utilization.
# Autoscaler handles burst; increase min_count to 5 if enabling Pass 3+.
#
# CPU requests at production sizing (all passes):
#   backend ×3 (3.0) + platformBackend ×2 (1.0) + ingestQueue ×3 (3.0)
#   + queue ×3 (3.0) + frontend ×2 (1.0) + playground (0.5) + aceBackend (0.2)
#   + hostBackend ×2 (1.0) + listener ×2 (1.0) + operator (0.5)
#   + agentBuilder ×2 (1.0) + clickhouse (2.0) + system (0.65) = ~17.9 vCPU
default_node_pool_vm_size   = "Standard_D8s_v3"
default_node_pool_min_count = 3     # minimum 3 for Pass 2; set 5 for Pass 3+
default_node_pool_max_count = 10
default_node_pool_max_pods  = 60

# Large pool: for ClickHouse isolation + LangGraph agent deployment pods (Pass 3+)
additional_node_pools = {
  large = {
    vm_size   = "Standard_D16s_v3"   # 16 vCPU, 64 GiB
    min_count = 0                     # scales from zero — not needed for Pass 2 alone
    max_count = 2
  }
}

#------------------------------------------------------------------------------
# Ingress
#------------------------------------------------------------------------------
ingress_controller = "nginx"

#------------------------------------------------------------------------------
# DNS + TLS — Public IP DNS label + Let's Encrypt HTTP-01
#   Works with all ingress controllers (nginx, istio, istio-addon, envoy-gateway).
#   → https://<dns_label>.<location>.cloudapp.azure.com
#   For custom domain: swap to tls_certificate_source = "dns01" + langsmith_domain
#------------------------------------------------------------------------------
dns_label        = "langsmith-prod"       # → langsmith-prod.eastus.cloudapp.azure.com
tls_certificate_source = "letsencrypt"
letsencrypt_email      = "you@example.com"

#------------------------------------------------------------------------------
# Key Vault
#------------------------------------------------------------------------------
keyvault_purge_protection = true   # required for production

#------------------------------------------------------------------------------
# Blob storage — production retention
#------------------------------------------------------------------------------
blob_ttl_enabled    = true
blob_ttl_short_days = 14    # short-lived trace payloads
blob_ttl_long_days  = 400   # run attachments (~13 months)

#------------------------------------------------------------------------------
# LangSmith
#------------------------------------------------------------------------------
langsmith_namespace    = "langsmith"
langsmith_release_name = "langsmith"

#------------------------------------------------------------------------------
# Sizing — production (multi-replica + HPA)
#------------------------------------------------------------------------------
sizing_profile = "production"

# Pass 3 — LangGraph Platform
# enable_deployments = true

# Pass 4 — Fleet (successor to Agent Builder; prefer this for new deploys).
# Also creates a langsmith_fleet Postgres database. Requires enable_deployments.
# Mutually exclusive with enable_agent_builder.
# enable_fleet = true

# Pass 4 — Agent Builder (legacy)
# enable_agent_builder = true

# Pass 5 — Insights / Polly
# enable_insights = true
# enable_polly    = true

#------------------------------------------------------------------------------
# Optional add-ons — recommended for production
#------------------------------------------------------------------------------
# create_diagnostics = true   # Log Analytics + diagnostic settings
# log_retention_days = 90     # default; raise for a longer compliance window

# create_waf = true   # Azure WAF policy (OWASP 3.2 + bot protection)
# Start in Detection. The OWASP core rule set matches SQL and script fragments
# that appear legitimately in LangSmith prompts and traces, so review the
# firewall log and add exclusions before switching to Prevention.
# waf_mode = "Prevention"

#------------------------------------------------------------------------------
# Network hardening
#------------------------------------------------------------------------------
# Default-deny firewalls on Storage, Key Vault, and the AKS API server. AKS pods
# reach Storage and Key Vault over service endpoints on the AKS subnet and are
# allowlisted automatically — list only the clients that need those data planes
# directly (operator workstations, CI runners, jumpboxes). The defaults below are
# left empty so a first apply works from anywhere; production should set them.
# storage_allowed_ips      = ["203.0.113.42/32"]
# aks_authorized_ip_ranges = ["203.0.113.42/32", "198.51.100.0/24"]

# Key Vault default-deny. The first apply writes ~10 secrets over the data plane
# from whatever host runs Terraform, so "Deny" with an incomplete
# keyvault_allowed_ips fails that apply. Either include the apply host's egress
# IP here, or apply once with the default "Allow" and switch to "Deny" after.
# keyvault_default_action = "Deny"
# keyvault_allowed_ips    = ["203.0.113.42/32"]

#------------------------------------------------------------------------------
# Chart version
#------------------------------------------------------------------------------
# Pin the chart for reproducible deploys. Must be on the 0.16 line — these
# values use the 0.16 schema and deploy.sh rejects anything else.
# langsmith_helm_chart_version = "0.16.1"

#------------------------------------------------------------------------------
# Attaching to infrastructure the platform team owns
#------------------------------------------------------------------------------
# This profile assumes Terraform creates the VNet, the AKS cluster, and the Key
# Vault. To deploy onto a cluster, VNet, or vault that already exists, see the
# matching sections of terraform.tfvars.example:
#   create_cluster  = false  + existing_cluster_name / _resource_group_name
#   create_vnet     = false  + aks_subnet_id / postgres_subnet_id / redis_subnet_id
#   create_keyvault = false  + existing_keyvault_name / _resource_group_name
# Each path has prerequisites the plan checks, and the Key Vault path needs role
# assignments a platform team usually has to grant by hand.
#
# On an existing cluster, also turn off anything the cluster already runs — a
# second install of either one fails the apply on conflicting CRDs:
# install_cert_manager = false
# install_keda         = false

#------------------------------------------------------------------------------
# Multi-AZ — for zone-redundant HA (optional)
#------------------------------------------------------------------------------
# AKS applies zones at node pool CREATION only. Changing availability_zones on a
# live deployment fails the plan; recreate the node pool instead.
# Redis is not here: Azure Managed Redis rejects an explicit zone list and is
# zone-redundant automatically in regions that have zones.
# availability_zones                 = ["1", "2", "3"]   # AKS nodes + Postgres primary
# postgres_standby_availability_zone = "2"
# postgres_geo_redundant_backup      = true
