# LangSmith on Azure — Terraform Variables Example
# ─────────────────────────────────────────────────────────────────────────────
# Copy to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars
#
# Sensitive values (passwords, license key, Fernet keys) are NOT set here.
# Run ./setup-env.sh — prompts on first run, reads from Key Vault on subsequent runs.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────
subscription_id = "your-azure-subscription-id"   # az account show --query id -o tsv

# ── Naming ────────────────────────────────────────────────────────────────────
# Name of this deployment. Appended to every resource name and used as the
# 'environment' tag. No leading hyphen — Terraform adds the separator, so
# "prod" gives langsmith-rg-prod. Examples: "prod", "staging", "dz"
name_prefix = "prod"
location    = "eastus"

# Give the globally-unique names (Postgres, Redis, Storage, Key Vault) a
# per-subscription hash so they cannot collide with another LangSmith deployment.
# On an EXISTING deployment leave this false — flipping it renames every resource,
# which Terraform executes as destroy-and-recreate.
unique_resource_names = true

# Bump this to rotate that hash when a failed apply burned the four global names
# (a soft-deleted Key Vault holds its name for the whole retention window). Any
# value that differs from the last one works. Same destroy-and-recreate warning as
# above — before the first successful apply only.
# name_suffix_salt = "2"

# Optional tags for cost allocation and compliance
# environment = "prod"   # defaults to name_prefix; set only to tag it differently
# owner       = "platform-team"
# cost_center = "engineering"

# ── Sources — external managed services ───────────────────────────────────────
postgres_source   = "external"    # "external" = Azure DB for PostgreSQL Flexible Server
redis_source      = "external"    # "external" = Azure Managed Redis
clickhouse_source = "in-cluster"  # "in-cluster" = chart-managed StatefulSet (dev/POC)
                                  # "external"   = LangChain Managed ClickHouse, Altinity,
                                  #                or any reachable ClickHouse. init-values.sh
                                  #                prompts for the connection details.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
postgres_admin_username      = "langsmith"
postgres_database_name       = "langsmith"    # database name on the server
# Server sizing. Check what your subscription is actually offered before changing these:
#   az postgres flexible-server list-skus -l <region> -o table
# postgres_sku_name     = "GP_Standard_D2ds_v4"
# postgres_version      = "16"      # see below before changing this on a live server
# postgres_storage_mb   = 32768     # 32 GB, auto-grow is off, size upfront
# postgres_storage_tier = "P4"      # raise for more IOPS at the same disk size
# postgres_backup_retention_days = 7  # days of automated backups to keep, 7 through 35
#
# Deployments created before postgres_version existed are running 14. They now plan an
# in-place major upgrade to 16 on the next apply, which is irreversible and takes downtime.
# Set postgres_version = "14" to stay put.

# ── Redis (Azure Managed Redis / AMR) ─────────────────────────────────────────
# redis_source = "external" provisions Azure Managed Redis (Microsoft.Cache/redisEnterprise,
# Redis 7.x, OSS clustering, private endpoint). amr_sku picks the size.
# B1 = 1 GB. Balanced_B0 (0.5 GB) is cheaper but sits on the most capacity-constrained
# pool and intermittently fails to allocate, and it can't run high availability.
amr_sku                 = "Balanced_B1"
redis_high_availability = false   # set true for production (required for the AMR SLA)
# A larger SKU does not cure InsufficientCapacity — the shortage is regional and reaches
# every Balanced size. Move just the AMR cluster instead; the private endpoint and every
# other resource stay in var.location, so this buys a cross-region private link.
# redis_location        = "eastus2"

# ── AKS ───────────────────────────────────────────────────────────────────────
# Node sizing: Standard_D8s_v3 (8 vCPU, 32 GiB) — AKS reserves ~1.7 vCPU/node,
# leaving ~6.3 allocatable per node.
#
# CPU requests at minimum replicas (production sizing):
#   backend ×3 (3.0) + platformBackend ×2 (1.0) + ingestQueue ×3 (3.0)
#   + queue ×3 (3.0) + frontend ×2 (1.0) + playground (0.5) + aceBackend (0.2)
#   + clickhouse (2.0) + system pods (0.7) = ~14.4 vCPU total requests
#
# min_count guidance (autoscaler scales up from this floor immediately):
#   3  — Pass 2 (core LangSmith, no addons). ~76% CPU utilization. Min for prod.
#   5  — Pass 3+ (+ Deployments, Agent Builder). Headroom for HPA burst.
#   6  — Pass 4+ (+ Agent Builder + dynamic operator pods). Recommended if enabling all.
#  10  — max_count ceiling; autoscaler handles load spikes.
#
# Cost estimate (eastus, on-demand):
#   3× Standard_D8s_v3 ≈ $0.38/hr each ≈ $830/mo
#   5× Standard_D8s_v3 ≈ $1.38/mo
#
default_node_pool_vm_size   = "Standard_D8s_v3"  # 8 vCPU, 32 GiB
default_node_pool_min_count = 3                   # minimum 3 for Pass 2 production
default_node_pool_max_count = 10                  # autoscaler ceiling
default_node_pool_max_pods  = 60                  # AKS default 30 is too low; Pass 2 needs ~32 pods

# Large pool: for ClickHouse isolation + LangGraph agent deployment pods (Pass 3+)
# ClickHouse production sizing requests 2 vCPU / 8 GiB — fits on the default pool.
# Use the large pool to dedicate a node to ClickHouse for predictable I/O, or
# to host operator-spawned agent deployment pods which have unpredictable resource usage.
additional_node_pools = {
  large = {
    vm_size   = "Standard_D16s_v3"  # 16 vCPU, 64 GiB
    min_count = 0                   # scales from zero — not needed for Pass 2 alone
    max_count = 2
  }
}

# ── Ingress controller ────────────────────────────────────────────────────────
# "nginx"         — NGINX ingress via Helm (standard, start here)
# "istio-addon"   — Azure managed Istio, AKS service mesh add-on (production/multi-dataplane)
# "istio"         — Istio via Helm (self-managed)
# "agic"          — Application Gateway Ingress Controller (enterprise Azure, native WAF)
#                   Provisions App Gateway v2 + a dedicated /24 subnet, and enables the
#                   AKS ingress-appgw add-on (Microsoft deprecated the AGIC Helm chart)
#                   Set create_waf = true for a WAF; it moves the gateway to WAF_v2
# "envoy-gateway" — Envoy Gateway via Helm (Gateway API native, uses Gateway/HTTPRoute)
# "none"          — skip (bring your own)
ingress_controller = "nginx"

# Istio addon revision — only used when ingress_controller = "istio-addon"
# Run: az aks mesh get-upgrades -g <rg> -n <cluster>  to list available revisions
# istio_addon_revision = "asm-1-27"

# AGIC options — only used when ingress_controller = "agic"
# agw_sku_tier            = "Standard_v2"   # create_waf = true forces WAF_v2
# agic_subnet_address_prefix = ["10.0.96.0/24"]  # must not overlap other subnets
# Scope of AGIC's Network Contributor grant: "vnet" (default), "subnet", or "none".
# Prefer "subnet" in a VNet you do not own — it is all AGIC needs. See INGRESS_CONTROLLERS.md.
# agic_network_contributor_scope = "subnet"

# ── DNS + TLS ─────────────────────────────────────────────────────────────────
# Azure Public IP DNS label — free Azure subdomain, no domain registration needed.
# Azure assigns <dns_label>.<location>.cloudapp.azure.com to the ingress LB public IP.
# deploy.sh applies the annotation to the right LB service based on ingress_controller.
# Not applicable to AGIC — use langsmith_domain or terraform output agw_public_ip_fqdn.
#
# ⚠️  TLS compatibility:
#   letsencrypt (HTTP-01) works with: nginx, istio (self-managed), envoy-gateway
#   letsencrypt does NOT work with:   istio-addon, agic  (no IngressClass — ACME challenge fails)
#   dns01 works with: all controllers (requires custom domain — see Option C)
#   See INGRESS_CONTROLLERS.md for the full compatibility matrix.
#
# Option A: HTTP only — quickstart default, zero cert setup (validated ✅)
#   → http://<dns_label>.<location>.cloudapp.azure.com
#
dns_label              = "langsmith-prod"     # → langsmith-prod.eastus.cloudapp.azure.com
tls_certificate_source = "none"

# Option B: HTTPS via Let's Encrypt HTTP-01 — nginx only (validated ✅)
#   → https://<dns_label>.<location>.cloudapp.azure.com
# tls_certificate_source = "letsencrypt"
# letsencrypt_email      = "you@example.com"

# Option C: Custom domain + DNS-01 — all controllers, works behind firewalls
#   Requires: Azure DNS zone + NS delegation at registrar (one-time setup).
#   → https://langsmith.example.com
# tls_certificate_source = "dns01"
# create_dns_zone        = true
# langsmith_domain       = "langsmith.example.com"
# letsencrypt_email      = "you@example.com"

# ── Key Vault ─────────────────────────────────────────────────────────────────
keyvault_purge_protection = false   # set true for production

# Optional: override the generated Key Vault name (must be globally unique, 3–24 chars)
# keyvault_name = "my-langsmith-kv"

# Optional: attach to a Key Vault the customer already owns instead of creating one.
# Terraform writes its nine secrets into it and changes nothing else about the vault,
# so the settings above are ignored. Requires a vault in Azure RBAC mode with
# Key Vault Secrets Officer already granted to the deployer. See the README section
# "Deploying against an existing Key Vault" for the full prerequisites.
# create_keyvault                       = false
# existing_keyvault_name                = "customer-platform-kv"
# existing_keyvault_resource_group_name = "customer-platform-rg"

# ── Blob storage ──────────────────────────────────────────────────────────────
blob_ttl_enabled    = true
blob_ttl_short_days = 14    # short-lived trace payloads
blob_ttl_long_days  = 400   # run attachments (~13 months)

# ── LangSmith ─────────────────────────────────────────────────────────────────
langsmith_namespace    = "langsmith"
langsmith_release_name = "langsmith"

# ── Helm sizing + addon feature flags ─────────────────────────────────────────
# Read by helm/scripts/init-values.sh and helm/scripts/deploy.sh.
# Set flags and re-run `make init-values && make deploy` to enable each pass.
#
# Sizing profiles (controls which examples/langsmith-values-sizing-*.yaml is applied):
#   minimum          — absolute minimum (demos, very constrained clusters)
#   dev              — single-replica, minimal resources (dev / CI / demos)
#   production       — multi-replica with HPA (recommended for all real workloads)
#   production-large — high-volume (~50 concurrent users, ~1000 traces/sec)
#
sizing_profile = "production"

# Pass 3 — LangGraph Platform (hostBackend, listener, operator)
# Required before enabling agent_builder, insights, or polly.
# enable_deployments = true

# Pass 4 — Agent Builder UI (fleetToolServer, fleetTriggerServer)
# enable_agent_builder = true

# Pass 5 — Insights (ClickHouse-backed trace analytics)
# enable_insights = true

# Pass 5 — Polly (AI eval / monitoring agent)
# enable_polly = true

# ── Optional modules ──────────────────────────────────────────────────────────
# Each is independently toggleable — safe to add after initial deploy.
# create_waf         = true   # Azure WAF policy (OWASP 3.2 + bot protection)
# create_diagnostics = true   # Log Analytics + diagnostic settings (recommended for prod)
# create_bastion     = true   # Jump VM for private AKS node access

# ── Multi-AZ (optional) ───────────────────────────────────────────────────────
# availability_zones defaults to [], which lets Azure place the node pool and
# the database. Pin zones only when your VM and database sizes are offered in
# all of them — README.md "Multi-AZ Support" has the az vm list-skus check.
# postgres_high_availability           = true             # Postgres standby in another zone
# availability_zones                   = ["1", "2", "3"]  # pin the AKS node pool
# postgres_standby_availability_zone   = "2"              # pin the standby; needs pinned zones
# postgres_geo_redundant_backup        = true             # geo-redundant backups

# ── Networking (optional — override only if reusing existing VNet) ─────────────
# Set create_vnet = false and give the VNet you want LangSmith to deploy into.
# Each subnet is then independent: supply an ID to reuse a subnet you already
# have, or leave it out and Terraform creates that subnet inside your VNet from
# the matching address prefix. Terraform applies the settings each service
# needs — the Postgres subnet gets the Microsoft.DBforPostgreSQL/flexibleServers
# delegation, the AKS subnet gets the Storage and Key Vault service endpoints,
# and the Redis subnet gets no delegation (it holds a private endpoint, and a
# delegated subnet would reject it).
#
# create_vnet          = false
# vnet_id              = "/subscriptions/.../resourceGroups/net-rg/providers/Microsoft.Network/virtualNetworks/my-vnet"
#
# Reuse subnets you already have. Give three different subnets — sharing one
# fails during apply, since the Postgres subnet is delegated and Azure allows no
# other resource type inside a delegated subnet.
# An existing Postgres subnet must already carry the flexibleServers delegation
# and hold nothing else. An existing AKS subnet must carry both the
# Microsoft.Storage and Microsoft.KeyVault service endpoints, since the storage
# and Key Vault firewalls allowlist it by ID and Azure rejects a subnet rule
# without the matching endpoint. It must also be big enough for the node pools
# below: Azure CNI draws node and pod IPs from it, 764 addresses at the
# defaults, so a /22 or larger. Terraform checks all of this at plan time, which
# means plan needs read access to whichever subnets you supply here.
# aks_subnet_id        = "/subscriptions/.../virtualNetworks/my-vnet/subnets/aks"
# postgres_subnet_id   = "/subscriptions/.../virtualNetworks/my-vnet/subnets/postgres"
# redis_subnet_id      = "/subscriptions/.../virtualNetworks/my-vnet/subnets/redis"
#
# Have Terraform add the two service endpoints to the AKS subnet above rather
# than fail the plan when they are missing. It patches that one property and
# leaves the rest of the subnet alone, but it needs write access on the subnet,
# so leave this off if a network team owns it and only granted read, or if their
# tooling sets the endpoints too. Otherwise add them yourself, repeating any
# already there since the flag replaces the whole list:
#   az network vnet subnet update --ids <subnet-id> \
#     --service-endpoints Microsoft.Storage Microsoft.KeyVault
# manage_byo_subnet_service_endpoints = true
#
# Or omit an ID above and set its prefix here to have Terraform carve it out.
# These defaults are sized for the 10.0.0.0/17 VNet Terraform builds, so treat
# them as a starting point. Plan reads your VNet and rejects a prefix outside its
# address space, but cannot tell whether one collides with a subnet that already
# exists there, so pick ranges you know are free.
# aks_subnet_address_prefix      = ["10.0.0.0/19"]
# postgres_subnet_address_prefix = ["10.0.32.0/20"]
# redis_subnet_address_prefix    = ["10.0.48.0/20"]
#
# Required when create_vnet = false. Kubernetes assigns ClusterIPs from this
# range, and AKS requires one that nothing on or connected to your VNet uses.
# The 10.0.64.0/20 default only avoids the VNet Terraform builds, and an overlap
# with your own space can be accepted at cluster creation and break later, so
# pick a range outside your VNet entirely — plan rejects one that overlaps it,
# though peered networks are on you. aks_dns_service_ip is derived from it.
# aks_service_cidr     = "10.100.0.0/20"
#
# create_bastion and ingress_controller = "agic" each need a subnet to
# themselves. Terraform carves those only out of a VNet it owns, so on this path
# you supply them; there is no prefix to carve from. Plan rejects either feature
# with create_vnet = false and no subnet named here.
# agic_subnet_id    = "/subscriptions/.../virtualNetworks/my-vnet/subnets/appgw"
# bastion_subnet_id = "/subscriptions/.../virtualNetworks/my-vnet/subnets/AzureBastionSubnet"

# ── Network hardening (production) ────────────────────────────────────────────
# Storage / Key Vault / AKS default-deny firewalls. AKS pods are allowlisted
# automatically via service endpoints on the AKS subnet — add operator IPs
# here only for clients that need to reach the data plane (CI runners,
# jumpboxes, operator workstations). Empty lists keep the legacy permissive
# defaults so the starter quickstart works without extra plumbing.
# storage_allowed_ips      = ["203.0.113.42/32"]
# keyvault_default_action  = "Deny"
# keyvault_allowed_ips     = ["203.0.113.42/32"]
# aks_authorized_ip_ranges = ["203.0.113.42/32", "198.51.100.0/24"]

# ── Constrained role-assignment delegation (optional) ─────────────────────────
# Set only if `terraform apply` fails with a 403 AuthorizationFailed on
# Microsoft.Authorization/roleAssignments/write. Some subscriptions delegate
# that permission through an ABAC condition on principalType, which rejects
# requests that leave the field out. Grants to managed identities already
# declare "ServicePrincipal"; this covers the apply identity's own Key Vault
# grant, which is a user interactively and a service principal in CI.
# terraform_principal_type = "User"
