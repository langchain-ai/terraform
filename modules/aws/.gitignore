# Terraform state and working directories
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.backup
*.tfstate.*.backup

# Terraform variable files (keep examples, ignore actuals)
*.tfvars
*.auto.tfvars.json
!*.tfvars.example
secrets.auto.tfvars

# Terraform plan outputs
plan.out

# Legacy local secret files (setup-env.sh no longer creates or refreshes them)
infra/.pg_password
infra/.api_key_salt
infra/.jwt_secret
infra/.license_key
infra/.admin_password
infra/.admin_email

# Helm values that make init-values writes, and your langsmith-values-local.yaml.
# They name this install's hosts and resources. A 0.17 values-overrides.yaml can
# hold plaintext secrets.
**/helm/values/langsmith-values*.yaml
!**/helm/values/langsmith-values*.yaml.example
**/helm/values/langsmith-sandbox-values*.yaml
**/values-overrides.yaml

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Test reports and run artifacts
reports/test-runs/
reports/infrastructure/
reports
# OS artifacts
.DS_Store
