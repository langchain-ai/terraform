# Terraform state and working directories
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.backup
*.tfstate.*.backup

# Terraform variable files (keep examples, ignore actuals)
*.tfvars
*.auto.tfvars.json
!*.tfvars.example

# Terraform plan outputs
plan.out

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# OS artifacts
.DS_Store
