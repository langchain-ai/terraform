# LangSmith on GCP — Terraform Variables
#
# Copy this file to terraform.tfvars and customize for your environment:
#   cp terraform.tfvars.example terraform.tfvars
#
# ── Deployment Tier Guide ─────────────────────────────────────────────────────
#
# Tier 1 — All in-cluster (dev/POC only)
#   postgres_source   = "in-cluster"
#   redis_source      = "in-cluster"
#   clickhouse_source = "in-cluster"
#   No Cloud SQL, Memorystore, or external ClickHouse provisioned.
#   ⚠ Not for production — no HA, no managed backups, no SLAs.
#
# Tier 2 — External Postgres + Redis, in-cluster ClickHouse (quick-start)
#   postgres_source   = "external"   → Cloud SQL (private IP, VPC peering)
#   redis_source      = "external"   → Memorystore (private IP)
#   clickhouse_source = "in-cluster"
#   ⚠ In-cluster ClickHouse is dev/POC only — single pod, no replication.
#
# Tier 3 — All external (production recommended)
#   postgres_source   = "external"
#   redis_source      = "external"
#   clickhouse_source = "langsmith-managed"  (or "external" for self-hosted)
#   See: https://docs.langchain.com/langsmith/langsmith-managed-clickhouse
#
# ── Sensitive variables ───────────────────────────────────────────────────────
# Do NOT put passwords or keys directly in terraform.tfvars.
# Use environment variables or setup-env.sh (which can write/read Secret Manager):
#
#   export TF_VAR_postgres_password="..."
#   export TF_VAR_langsmith_license_key="..."
#   # Or:
#   source infra/scripts/setup-env.sh
#
# ── First time? ───────────────────────────────────────────────────────────────
#   make quickstart     — interactive wizard that generates this file for you
#   make setup-env      — set up secrets (prints the source command to run)

#------------------------------------------------------------------------------
# Required Variables
#------------------------------------------------------------------------------
project_id = "your-gcp-project-id"

#------------------------------------------------------------------------------
# Naming Configuration (IMPORTANT: Prevents resource collisions)
#------------------------------------------------------------------------------
# Prefix for all resource names - use your company/team name
# Format: {prefix}-{environment}-{resource}-{suffix}
# Example with prefix="myco": myco-prod-gke-a1b2c3d4
name_prefix = "myco"  # Change to your company/team prefix (max 11 chars)

# Add random suffix to resource names (recommended for multi-tenant projects)
unique_suffix = true

# Environment name
environment = "test"  # dev, staging, prod, test, uat

#------------------------------------------------------------------------------
# Optional: Regional Configuration
#------------------------------------------------------------------------------
region = "us-west2"
zone   = "us-west2-a"

#------------------------------------------------------------------------------
# Optional: Networking
#------------------------------------------------------------------------------
# Note: External PostgreSQL and Redis always use private connections (VPC peering)
# Requires: servicenetworking.networksAdmin role (for VPC peering)

# Ensure these don't overlap with existing ranges in your project
subnet_cidr   = "10.0.0.0/20"
pods_cidr     = "10.4.0.0/14"
services_cidr = "10.8.0.0/20"

#------------------------------------------------------------------------------
# Optional: GKE Configuration
#------------------------------------------------------------------------------
gke_use_autopilot   = false        # Set to true for Autopilot mode
gke_node_count      = 2            # Initial nodes per zone (Standard mode)
gke_min_nodes       = 2            # Min nodes for autoscaling
gke_max_nodes       = 10           # Max nodes for autoscaling
# Machine type - ClickHouse requires nodes with 4+ vCPU and 16GB+ RAM
# Recommended: e2-standard-8 (8 vCPU, 32GB) for medium workloads
# Minimum: e2-standard-4 (4 vCPU, 16GB) for small workloads
gke_machine_type            = "e2-standard-4"
gke_disk_size               = 100          # GB
gke_release_channel         = "REGULAR"    # RAPID, REGULAR, or STABLE
gke_deletion_protection     = true         # Prevent accidental cluster deletion
gke_network_policy_provider = "DATA_PLANE_V2"  # CALICO (legacy) or DATA_PLANE_V2 (recommended)

# Master authorized networks. Empty list keeps the GKE master publicly
# reachable so Terraform-managed Helm/kubectl steps work from any apply host.
# Production deployments restrict to operator/CI egress CIDRs.
# gke_master_authorized_cidrs = [
#   { cidr_block = "203.0.113.42/32",  display_name = "operator-laptop" },
#   { cidr_block = "198.51.100.0/24",  display_name = "ci-runners"      },
# ]

#------------------------------------------------------------------------------
# Optional: PostgreSQL Configuration
#------------------------------------------------------------------------------
# "external" — Cloud SQL with private IP (recommended)
# "in-cluster" — Postgres runs as a pod inside GKE (dev/POC only)
postgres_source = "external"

# Configuration for external PostgreSQL (Cloud SQL)
postgres_version             = "POSTGRES_18"
postgres_tier                = "db-custom-2-8192"  # 2 vCPU, 8GB RAM
postgres_disk_size           = 50                   # GB
postgres_high_availability   = true                 # REGIONAL for HA
postgres_deletion_protection = true                 # Blocks Terraform and the Cloud SQL API; set false before destroy

# PostgreSQL password (sensitive — use environment variable, not this file)
# Set via: export TF_VAR_postgres_password="your-secure-password"
# Or run:  source infra/scripts/setup-env.sh
# postgres_password = ""

# PostgreSQL database flags (optional)
# postgres_database_flags = [
#   { name = "max_connections",    value = "500" },
#   { name = "log_checkpoints",    value = "on"  },
#   { name = "log_connections",    value = "on"  },
#   { name = "log_disconnections", value = "on"  },
# ]

# SSL enforcement on the Cloud SQL connection (default: ENCRYPTED_ONLY).
# ENCRYPTED_ONLY                      — require TLS for every connection (default)
# ALLOW_UNENCRYPTED_AND_ENCRYPTED     — accept plaintext (only for legacy migration tools)
# TRUSTED_CLIENT_CERTIFICATE_REQUIRED — TLS + client certificate required
# postgres_ssl_mode = "ENCRYPTED_ONLY"

#------------------------------------------------------------------------------
# Optional: Redis Configuration
#------------------------------------------------------------------------------
# "external" — Memorystore (recommended)
# "in-cluster" — Redis runs as a pod inside GKE (dev/POC only)
redis_source            = "external"
redis_version           = "REDIS_7_2"
redis_memory_size       = 5    # GB
redis_high_availability = true # Standard HA tier
redis_prevent_destroy   = true # Set true to block accidental Redis destruction

#------------------------------------------------------------------------------
# Optional: Sandboxes
#------------------------------------------------------------------------------
# Enables infrastructure prerequisites for LangSmith Sandboxes.
#
# Sandboxes use the sandbox-host architecture in the same GKE cluster and
# namespace as LangSmith. This creates a dedicated Standard GKE node pool with
# nested virtualization and the label/taint expected by the Helm chart:
#   sandbox.langsmith.com/host=true
#
# Requirements:
#   - gke_use_autopilot = false. Autopilot does not support the required
#     dedicated nested-virtualization node pool.
#   - enable_gcp_iam_module = true so the JuiceFS CSI node service account can
#     access the shared GCS bucket via Workload Identity.
#   - Dedicated sandbox-host nodes that expose usable Linux KVM (/dev/kvm).
#     The default is n2-standard-8, which matches the tested live
#     configuration. Other example machine types include n2-highmem-8,
#     n1-standard-8, c3-standard-8, and c4-standard-8. GCP nested
#     virtualization is not available on E2, memory-optimized, AMD-powered,
#     Arm-powered, or H4D machine types.
#
# When sandboxes are enabled, the module creates a restricted sandbox-host node
# service account and assigns it only the standard GKE node/telemetry roles.
# JuiceFS object-store access stays on the Workload Identity service account
# used by the JuiceFS CSI node service account, not on the node identity.
#
# enable_sandboxes = true
# sandbox_juicefs_redis_memory_size = 5
# sandbox_juicefs_redis_high_availability = true
# For SaaS-like production scale:
# sandbox_juicefs_redis_memory_size = 20
# sandbox_juicefs_redis_rdb_snapshot_period = "ONE_HOUR"
# sandbox_host_node_count = 1
# sandbox_host_min_node_count = 1
# sandbox_host_max_node_count = 5
# sandbox_host_machine_type = "n2-standard-8"
# Optional: requests injected into sandbox containers that omit them. These
# values preserve namespace request-quota accounting without imposing limits
# on sandbox-host and its Firecracker VM child cgroups.
# sandbox_default_container_requests = {
#   cpu    = "100m"
#   memory = "128Mi"
# }
# Optional: larger host nodes can attach local SSDs for JuiceFS cache backed
# ephemeral storage. Some machine types only allow specific local SSD counts;
# confirm the selected machine type supports the requested count.
# sandbox_host_ephemeral_local_ssd_count = 7
#
# Required by init-values.sh when enable_sandboxes = true. Use the same release
# tag as the other LangSmith images.
# sandbox_host_image_tag = "0.0.0"
# Optional: enables browser/programmatic service URLs for HTTP services running inside sandboxes.
# Requires wildcard DNS and TLS for *.<host>.
# sandbox_service_url_base_url = "https://sandbox-services.example.com"

#------------------------------------------------------------------------------
# Optional: Storage Configuration
#------------------------------------------------------------------------------
storage_ttl_short_days = 14    # Short-lived trace TTL (ttl_s/ prefix, default: 14 days)
storage_ttl_long_days  = 400   # Long-lived trace TTL (ttl_l/ prefix, default: 400 days)
storage_force_destroy  = false # Prevent bucket deletion with objects

#------------------------------------------------------------------------------
# Optional: ClickHouse Configuration
# Reference: https://docs.langchain.com/langsmith/langsmith-managed-clickhouse
#------------------------------------------------------------------------------
# ClickHouse deployment type:
#   "in-cluster"        — (default) Deployed as a pod in the cluster via Helm.
#                         ⚠  Dev/POC only — single pod, no replication, no backups.
#   "langsmith-managed" — Managed by LangChain team (recommended for production).
#                         See: https://docs.langchain.com/langsmith/langsmith-managed-clickhouse
#   "external"          — Self-hosted external ClickHouse instance
clickhouse_source = "in-cluster"

# --- For langsmith-managed or external ClickHouse ---
# clickhouse_host      = "your-clickhouse-host.example.com"
# clickhouse_port      = 9440     # Native port (9440 for TLS, 9000 for non-TLS)
# clickhouse_http_port = 8443     # HTTP port (8443 for TLS, 8123 for non-TLS)
# clickhouse_user      = "default"
# clickhouse_password  = "your-password"  # Or: export TF_VAR_clickhouse_password
# clickhouse_database  = "default"
# clickhouse_tls       = true

# Optional: Custom CA certificate for ClickHouse TLS verification
# clickhouse_ca_cert = file("${path.module}/certs/clickhouse-ca.crt")

#------------------------------------------------------------------------------
# Optional: LangSmith Configuration
#------------------------------------------------------------------------------
langsmith_namespace = "langsmith"
langsmith_domain    = "langsmith.example.com"

# License key (sensitive — use environment variable, not this file)
# Set via: export TF_VAR_langsmith_license_key="your-license-key"
# langsmith_license_key = ""

# Optional: Pin Helm chart version (recommended for reproducible deploys)
# Empty = use latest available chart version
langsmith_helm_chart_version = ""

#------------------------------------------------------------------------------
# Optional: TLS / HTTPS Configuration
#------------------------------------------------------------------------------
# ── Staged-deploy walkthrough ──────────────────────────────────────────────
#
# If you don't have a certificate yet, deploy in two passes:
#
# Pass 1 — HTTP only (get the Gateway IP):
#   tls_certificate_source = "none"
#   terraform apply
#   # Note the gateway IP from terraform output or: kubectl get gateway -n envoy-gateway-system
#   # Point your DNS A record to the gateway IP, then wait for DNS to propagate.
#
# Pass 2 — Enable TLS:
#   tls_certificate_source = "letsencrypt"
#   letsencrypt_email       = "you@example.com"
#   terraform apply
#   # cert-manager will provision the certificate automatically.
#
# ⚠  Warning: Do not delete and recreate the Gateway resource after you have DNS
#    pointing to it — GKE will issue a new external IP and your DNS record will
#    break. Use terraform apply (update-in-place) to change TLS configuration.

# Choose TLS certificate source:
#   "none"        — No TLS (HTTP only) — use for initial DNS setup (see above)
#   "letsencrypt" — Automatic via Let's Encrypt + cert-manager (recommended)
#   "existing"    — Provide your own TLS certificate and key
tls_certificate_source = "letsencrypt"

# --- Option 1: Let's Encrypt (automatic) ---
letsencrypt_email = "your-email@example.com"

# --- Option 2: Existing Certificates ---
# Set tls_certificate_source = "existing" and provide cert/key:
# Option A: Inline PEM content
# tls_certificate_crt = <<-EOT
#   -----BEGIN CERTIFICATE-----
#   ... your certificate ...
#   -----END CERTIFICATE-----
# EOT
# tls_certificate_key = <<-EOT
#   -----BEGIN PRIVATE KEY-----
#   ... your private key ...
#   -----END PRIVATE KEY-----
# EOT

# Option B: Load from files (recommended)
# tls_certificate_crt = file("${path.module}/certs/langsmith.crt")
# tls_certificate_key = file("${path.module}/certs/langsmith.key")

# Name for the TLS secret in Kubernetes
tls_secret_name = "langsmith-tls"

#------------------------------------------------------------------------------
# Optional: Ingress Configuration
#------------------------------------------------------------------------------
install_ingress = true
ingress_type    = "envoy"  # "envoy" (implemented), "istio" or "other" (reserved)

#------------------------------------------------------------------------------
# Optional: AWS-parity module wiring
#------------------------------------------------------------------------------
# Enable Workload Identity + bucket IAM grants module (recommended).
enable_gcp_iam_module = true

# Enable Secret Manager secret creation for bootstrap credentials.
# When true, postgres + redis passwords are stored in Secret Manager.
# Use setup-env.sh to manage secrets — it reads/writes Secret Manager automatically.
enable_secret_manager_module = false

# Enable Cloud DNS + managed cert module wiring.
enable_dns_module      = false
dns_create_zone        = true
dns_existing_zone_name = ""
dns_create_certificate = true

#------------------------------------------------------------------------------
# Optional: LangSmith Deployment (Deploy agents from UI)
# Reference: https://docs.langchain.com/langsmith/deploy-self-hosted-full-platform
#------------------------------------------------------------------------------
# Enables deploying agents/apps directly from LangSmith UI.
# Installs KEDA (Kubernetes Event-driven Autoscaling).
enable_langsmith_deployment = true

#------------------------------------------------------------------------------
# Optional: Product Feature Flags (LangGraph Platform)
# Set to true to enable addons. Each requires the matching license entitlement.
# deploy.sh reads these flags to decide which Helm values overlays to include.
#------------------------------------------------------------------------------

# Deployments — deploy agents/apps from the LangSmith UI
# Requires: KEDA (enable_langsmith_deployment = true)
enable_deployments = false

# Agent Builder — build, test, and iterate on agents in the LangSmith UI
# Requires: enable_deployments = true
enable_agent_builder = false

# Insights — advanced trace analytics powered by ClickHouse
# Requires: ClickHouse (in-cluster or external)
enable_insights = false

# Polly — AI-powered evaluation and monitoring
# Requires: enable_deployments = true and Polly entitlement in your license
enable_polly = false

# Usage telemetry — extended usage reporting (PHONE_HOME_USAGE_REPORTING_ENABLED)
# Enables additional product analytics sent back to LangChain
enable_usage_telemetry = false

#------------------------------------------------------------------------------
# Optional: SmithDB (chart 0.16+, early access)
#
# SmithDB is the in-chart columnar store and query engine that replaces
# ClickHouse for trace storage. Enabling it provisions:
#   - a dedicated Cloud SQL Postgres metastore on a private IP
#   - a dedicated single-region GCS bucket for .vortex segments
#   - a least-privilege GCP service account bound to the chart's SmithDB KSA
#     via Workload Identity (objectAdmin on that bucket only)
#   - two GKE node pools: one Local SSD-backed for the cache, one for compute
#
# Requires GKE Standard. Autopilot manages its own node pools, so the dedicated
# Local SSD pools do not exist there and SmithDB pods would stay Pending.
#
# Enabling the infrastructure does NOT move the chart line. Pass 2 needs an
# explicit chart version of 0.16 or newer:
#   CHART_VERSION=0.16.0 make deploy
# The 0.16 line has published release candidates only, so an exact prerelease
# tag is required; ranges like "~0.16.0" match no chart and are rejected.
# List what exists with:
#   helm search repo langchain/langsmith --versions --devel
#------------------------------------------------------------------------------
enable_smithdb = false

# --- Staged rollout ---------------------------------------------------------
# The services deploy detached from LangSmith and each gate is a separate,
# validated stage. Apply one at a time; migration and query both require
# ingestion, and Terraform enforces that. ClickHouse stays enabled throughout.
#
#   1) All gates false. Services come up, the metastore migration Job runs.
#      Confirm pods land on the SmithDB pools and reach Postgres and the bucket.
#   2) smithdb_ingestion_enabled = true. LangSmith writes to SmithDB as well as
#      ClickHouse; reads stay on ClickHouse. Confirm segments land in the bucket.
#   3) smithdb_migration_enabled = true, if you need historical data. Renders the
#      migration Job plus an in-chart taskdb Postgres StatefulSet. The Job asks
#      for 8 CPU and is unpinned, so the core node pool needs room. The backfill
#      itself is owned by LangChain Product/Engineering.
#   4) smithdb_query_enabled = true. Reads move to SmithDB.
# smithdb_ingestion_enabled = false
# smithdb_migration_enabled = false
# smithdb_query_enabled     = false

# Must match the Helm release name used in Pass 2. Chart-created service account
# names derive from it, and the Workload Identity binding is scoped to that exact
# name — a mismatch makes SmithDB's GCS access fail with 403.
# langsmith_release_name = "langsmith"

# --- Metastore --------------------------------------------------------------
# "create"   — dedicated Cloud SQL instance (default)
# "external" — bring your own Postgres 18+; for AlloyDB, run the Auth Proxy as a
#              sidecar via smithdb.commonInitContainers and point the host at
#              127.0.0.1 with smithdb_metastore_use_ssl = false.
# Must be a dedicated, empty database. Never point this at the LangSmith
# operational Postgres.
# smithdb_metastore_source              = "create"
# smithdb_metastore_database_version    = "POSTGRES_18"  # SmithDB requires PG 18+
# smithdb_metastore_tier                = "db-custom-2-8192"
# smithdb_metastore_disk_size           = 50
# smithdb_metastore_high_availability   = false
# smithdb_metastore_use_ssl             = true

# --- Metastore TLS ----------------------------------------------------------
# Two supported modes. Both keep the instance at ssl_mode = ENCRYPTED_ONLY.
#
# 1) Auth Proxy (recommended). A Cloud SQL Auth Proxy sidecar runs in every
#    SmithDB Pod and holds the TLS session to Cloud SQL; SmithDB dials it on
#    127.0.0.1, so its own hop is plaintext by design and use_ssl must be false.
#    Terraform grants the SmithDB service account roles/cloudsql.client and
#    points the secret's host key at the loopback. Requires source = "create".
# smithdb_metastore_use_auth_proxy      = true
# smithdb_metastore_use_ssl             = false
# Pin the tag. A floating one would change the proxy under a running release.
# smithdb_auth_proxy_image              = "gcr.io/cloud-sql-connectors/cloud-sql-proxy:2.25.0"
#
# 2) Direct TLS. SmithDB does not trust the Cloud SQL server CA, so a direct
#    connection to an ENCRYPTED_ONLY instance fails the handshake. Reaching it
#    without the proxy means relaxing the instance and turning TLS off, which
#    is a test/staging posture only:
# smithdb_metastore_ssl_mode            = "ALLOW_UNENCRYPTED_AND_ENCRYPTED"
# smithdb_metastore_use_ssl             = false
# See the metastore TLS section of SMITHDB.md.

# Teardown controls. Protection covers both Terraform and the Cloud SQL API, so
# a destroy fails until it is false and that change has been applied. Keep both
# at the production values below; flip them for a disposable dev/test stack that
# is destroyed and rebuilt.
# smithdb_metastore_deletion_protection = true
# smithdb_bucket_force_destroy          = false

# External metastore (smithdb_metastore_source = "external"):
# smithdb_external_metastore_host     = "10.0.0.5"
# smithdb_external_metastore_port     = 5432
# smithdb_external_metastore_database = "smithdb"
# smithdb_external_metastore_username = "smithdb"
# Password via: export TF_VAR_smithdb_external_metastore_password="..."

# --- Object store -----------------------------------------------------------
# Empty auto-generates {project_id}-{prefix}-{env}-smithdb{suffix}.
# Keep it single-region and in the cluster's region: multi-region and dual-region
# buckets add replication cost and unpredictable tail latency on segment reads.
# No lifecycle deletion rules are created, deliberately — expiring objects
# independently of SmithDB's own lifecycle makes data unavailable.
# smithdb_bucket_name    = ""
# CMEK; empty uses Google-managed keys. The module grants the Cloud Storage
# service agent roles/cloudkms.cryptoKeyEncrypterDecrypter on the key — if the
# key lives in another project, that project's IAM policy must allow it.
# smithdb_bucket_kms_key = ""
# Object versioning, off by default. SmithDB never overwrites a segment in
# place, so versioning retains a noncurrent copy of everything compaction
# deletes rather than protecting against overwrite. Enable only where a
# retention policy demands it, and add a noncurrent-age lifecycle rule.
# smithdb_bucket_versioning_enabled = false

# --- Node pools -------------------------------------------------------------
# The cache pool uses GKE's Local SSD-backed *ephemeral storage* mode, which is
# what makes the capacity show up as node allocatable ephemeral-storage and back
# the emptyDir volumes the SmithDB cache writes to. Raw block Local SSD does not.
#
# Machine type generation matters:
#   - N2/N2D (default): you choose the disk count below (375 GB each).
#   - C3/C4/Z3 "-lssd" types: the count is fixed by the machine type. Set
#     smithdb_instance_store_local_ssd_count = 0 or the pool fails to create.
#
# The cluster is regional. An unpinned pool tries every zone in the region and
# fails if the machine type or disk count is unavailable in any of them, so pin
# smithdb_node_locations after checking availability with:
#   gcloud compute machine-types list --filter="name=n2-standard-16 AND zone~^us-west2"
# smithdb_node_locations = ["us-west2-a", "us-west2-b"]

# At chart defaults the three cache workloads request 4 CPU each and 200Gi
# (query) + 100Gi (ingestion) + 100Gi (compactionWorker) of ephemeral storage,
# so all three fit on one n2-standard-16 (~15.9 allocatable vCPU). The default
# 2 x 375 GB = 750 GB raw covers that with headroom.
#
# The disk count is not free-form: Compute Engine accepts only specific values
# per machine type, and n2-standard-16 (an N2 with 12-20 vCPU) takes 2, 4, 8, 16
# or 24. A value like 3 is rejected when the node pool is created. Step up to 4
# if you override the resource requests upward in the values overlay.
# smithdb_instance_store_machine_type    = "n2-standard-16"
# smithdb_instance_store_local_ssd_count = 2
# smithdb_instance_store_min_nodes       = 0   # scale to zero when SmithDB is idle
# smithdb_instance_store_max_nodes       = 3
# smithdb_compute_machine_type           = "n2-standard-8"
# smithdb_compute_min_nodes              = 0
# smithdb_compute_max_nodes              = 3

#------------------------------------------------------------------------------
# Optional: Helm Sizing Profile
# Controls which langsmith-values-sizing-{profile}.yaml overlay deploy.sh loads.
# Run `make init-values` after changing this — it copies the sizing file from examples/.
#
#   "default"          — chart defaults (no overlay); suitable for quick tests
#   "minimum"          — absolute floor; fits e2-standard-4; not for production
#   "dev"              — single replica, minimal resources; dev/CI environments
#   "production"       — multi-replica with HPA; recommended for production
#   "production-large" — high-memory / high-CPU pattern; 50+ users, 1000+ traces/sec
#------------------------------------------------------------------------------
sizing_profile = "production"

#------------------------------------------------------------------------------
# Optional: LangGraph Platform Encryption Keys (sensitive)
# Auto-generated and stored in Secret Manager on first run when using setup-env.sh.
# Fernet keys: 32 random bytes, URL-safe base64-encoded.
# WARNING: Never change these after the first deployment — existing data will
# become unreadable. Rotation requires a coordinated migration procedure.
#------------------------------------------------------------------------------

# Set via: export TF_VAR_langsmith_deployments_encryption_key="..."
# Or run:  source infra/scripts/setup-env.sh  (auto-generates and stores)
# langsmith_deployments_encryption_key   = ""
# langsmith_agent_builder_encryption_key = ""
# langsmith_insights_encryption_key      = ""

#------------------------------------------------------------------------------
# Optional: Labels/Tags (Applied to all resources)
#------------------------------------------------------------------------------
owner       = "platform-team"  # Team or individual responsible
cost_center = "engineering"    # For billing attribution

# Additional custom labels
labels = {
  # "department" = "engineering"
  # "project"    = "langsmith"
}
