# App-specific configuration for the Terraform Helm deployment.
#
# Infrastructure values (project_id, region, cluster_name, bucket_name, etc.)
# are auto-populated by: make init-app
# Or set them manually in terraform.tfvars for "bring your own infra" scenarios.

# ── Required ──────────────────────────────────────────────────────────────────

admin_email = "admin@example.com"

# ── Optional overrides ────────────────────────────────────────────────────────

# hostname      = "langsmith.example.com"   # Defaults to Gateway IP
# chart_version = "0.15.17"                 # Empty = latest
# release_name  = "langsmith"

# ── SmithDB staged rollout ────────────────────────────────────────────────────
# enable_smithdb and the infra outputs are auto-populated by `make init-app`.
# SmithDB requires an exact chart_version of 0.16 or newer; enabling it does not
# move the chart line on its own. Ranges like "~0.16.0" never match the
# prerelease-only 0.16 line and are rejected. Advance one gate at a time,
# applying and validating each stage. Migration and query both require ingestion.
# chart_version             = "0.16.0-rc.22"
# smithdb_ingestion_enabled = false
# smithdb_migration_enabled = false
# smithdb_query_enabled     = false

# ── Sizing ────────────────────────────────────────────────────────────────────
# "production"       = multi-replica with HPA (~20 users, ~100 traces/sec)
# "production-large" = high-volume (~50 users, ~1000 traces/sec)
# "dev"              = single-replica, minimal resources (dev/CI/demos)
# "minimum"          = absolute floor (e2-standard-4); NOT for production
# "none"             = chart defaults

# sizing = "production"

# ── Feature toggles ──────────────────────────────────────────────────────────

# enable_agent_deploys   = true    # Deployments feature (LangGraph Platform)
# enable_agent_builder   = true    # Agent Builder (requires agent_deploys)
# enable_insights        = true    # Insights (requires ClickHouse below)
# enable_polly           = true    # Polly AI eval/monitoring (requires agent_deploys)
# enable_usage_telemetry = true    # Extended usage telemetry reporting

# ── ClickHouse (required when enable_insights = true) ────────────────────────

# clickhouse_host     = "clickhouse.example.com"
# clickhouse_port     = 9440      # Native port (9440 TLS, 9000 non-TLS)
# clickhouse_http_port = 8443     # HTTP port (8443 TLS, 8123 non-TLS)
# clickhouse_database = "default"
# clickhouse_username = "default"
# clickhouse_password = "changeme"
# clickhouse_tls      = true
